.TH "NIAC" "1" "Sep 2026" "NIAC" "NIAC Manual"

.SH NAME
niac-neighbors-watch - Watch neighbor table for live updates


.SH SYNOPSIS
\fBniac neighbors watch [flags]\fP


.SH DESCRIPTION
Watch the neighbor discovery table in real-time.

.PP
This subcommand continuously monitors the neighbor table and displays
updates as neighbors are discovered or expire. Similar to 'watch' command,
the display refreshes periodically to show current state.

.PP
Press Ctrl+C to stop watching.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for watch


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api\fP=""
	Daemon API address (default: https://127.0.0.1:8445, or NIAC_API_URL)

.PP
\fB--cacert\fP=""
	Daemon certificate to trust (default: the local daemon's own, when visible)

.PP
\fB--device\fP=""
	Filter by device name

.PP
\fB--insecure\fP[=false]
	Skip TLS verification, for a daemon whose certificate this host cannot see

.PP
\fB--json\fP[=false]
	Output in JSON format

.PP
\fB--protocol\fP="all"
	Filter by protocol: lldp, cdp, or all

.PP
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  # Watch all neighbors
  niac neighbors watch

  # Watch with JSON output
  niac neighbors watch --json

  # Watch specific device
  niac neighbors watch --device router-1

  # Watch only LLDP neighbors
  niac neighbors watch --protocol lldp
.EE


