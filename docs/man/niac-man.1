.TH "NIAC" "1" "Sep 2026" "NIAC" "NIAC Manual"

.SH NAME
niac-man - Generate man pages


.SH SYNOPSIS
\fBniac man [flags]\fP


.SH DESCRIPTION
Generate Unix man pages for NIAC commands.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for man

.PP
\fB-o\fP, \fB--output\fP="docs/man"
	output directory (relative paths resolve against the current working directory)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  # Generate man pages to ./docs/man/ (default)
  niac man

  # Generate to a specific directory
  niac man --output /tmp/niac-man

  # Install man pages (requires sudo)
  sudo cp docs/man/* /usr/local/share/man/man1/
  sudo mandb
.EE


.SH SEE ALSO
\fBniac(1)\fP


