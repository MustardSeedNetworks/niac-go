.TH "NIAC" "1" "Sep 2026" "NIAC" "NIAC Manual"

.SH NAME
niac-simulation-start - Start a scenario through the daemon


.SH SYNOPSIS
\fBniac simulation start [flags]\fP


.SH DESCRIPTION
Start a managed scenario through the daemon's simulation registry.


.SH OPTIONS
\fB--access-vlan\fP=0
	The VLAN for access or trunk mode

.PP
\fB--attachment\fP=""
	Attachment name from the scenario

.PP
\fB--attachment-mode\fP=""
	Physical binding mode: direct, access, or trunk (default: the interface's only approved policy)

.PP
\fB--config\fP=""
	Managed scenario configuration path

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for start

.PP
\fB-i\fP, \fB--interface\fP=""
	Physical network interface

.PP
\fB--session\fP=""
	Scenario session ID

.PP
\fB--template\fP=""
	Built-in scenario template name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api\fP=""
	Daemon API address (default: https://127.0.0.1:8445, or NIAC_API_URL)

.PP
\fB--cacert\fP=""
	Daemon certificate to trust (default: the local daemon's own, when visible)

.PP
\fB--insecure\fP[=false]
	Skip TLS verification, for a daemon whose certificate this host cannot see

.PP
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  niac simulation start -i eth0 --config clinic.yaml --session clinic
  niac simulation start -i eth0 --config clinic.yaml --attachment-mode access --access-vlan 200
.EE


.SH SEE ALSO
\fBniac-simulation(1)\fP


