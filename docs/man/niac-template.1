.SH NAME
niac-template - Manage configuration templates


.SH SYNOPSIS
\fBniac template [flags]\fP


.SH DESCRIPTION
List, show, and use pre-built configuration templates for common scenarios.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for template


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  # List all available templates
  niac template list

  # Show template contents
  niac template show basic-network

  # Create config from template
  niac template use small-office office.yaml

  # Apply template directly (validate and display info)
  niac template apply data-center
.EE


