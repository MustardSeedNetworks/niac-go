.SH NAME
niac-content-list - List what's installed in the library


.SH SYNOPSIS
\fBniac content list [flags]\fP


.SH DESCRIPTION
Print every kind (networks / walks / pcaps) currently in the library
along with the file count and on-disk size for each, plus a TOTAL row.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--root\fP=""
	Library root (default: NIAC_LIBRARY_ROOT or ~/.niac/library)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  # List the default library
  niac content list

  # Inspect a non-default library
  niac content list --root /var/lib/niac/library
.EE


.SH SEE ALSO
\fBniac-content(1)\fP


