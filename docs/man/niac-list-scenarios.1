.SH NAME
niac-list-scenarios - List runnable scenarios


.SH SYNOPSIS
\fBniac list scenarios [flags]\fP


.SH DESCRIPTION
List runnable scenario sources. Built-in templates are always
available. Installed library networks are shown when the content library can
be opened.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for scenarios


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--root\fP=""
	Library root (default: NIAC_LIBRARY_ROOT or ~/.niac/library)

.PP
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  # List built-in and installed scenarios
  niac list scenarios

  # Inspect a non-default library
  niac list scenarios --root /var/lib/niac/library
.EE


.SH SEE ALSO
\fBniac-list(1)\fP


