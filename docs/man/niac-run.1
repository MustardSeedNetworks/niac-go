.TH "NIAC" "1" "Sep 2026" "NIAC" "NIAC Manual"

.SH NAME
niac-run - Run network simulation


.SH SYNOPSIS
\fBniac run   [flags]\fP


.SH DESCRIPTION
Run NIAC network simulation with an optional terminal UI.

.PP
By default, runs in headless mode. Add --tui for interactive terminal UI.
Use "niac daemon" for the HTTPS web UI and API.


.SH OPTIONS
\fB-d\fP, \fB--debug\fP=1
	Debug level (0-3)

.PP
\fB-n\fP, \fB--dry-run\fP[=false]
	Validate config without starting simulation

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for run

.PP
\fB--no-color\fP[=false]
	Disable colored output

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Quiet mode (equivalent to -d 0)

.PP
\fB--tui\fP[=false]
	Enable interactive Terminal UI

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Verbose output (equivalent to -d 3)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--storage-keep\fP=500
	Run history records to keep, pruned oldest first on start (0 keeps every run)

.PP
\fB--storage-path\fP=""
	Path to NIAC run history database (default: ~/.niac/niac.db)


.SH EXAMPLE
.EX
  # Headless simulation
  sudo niac run en0 config.yaml

  # With Terminal UI (TUI)
  sudo niac run en0 config.yaml --tui

  # Validate config without running
  niac run en0 config.yaml --dry-run
.EE


.SH SEE ALSO
\fBniac(1)\fP


