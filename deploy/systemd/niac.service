[Unit]
Description=NIAC Network Device Simulator
Documentation=https://github.com/MustardSeedNetworks/niac-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=niac
Group=niac
# ProtectSystem=strict makes / read-only; without a writable CWD the daemon
# fails at first start creating its self-signed TLS cert dir ("mkdir certs:
# read-only file system"). Root the working dir + cert dir under the
# ReadWritePath /var/lib/niac so a fresh install starts cleanly.
WorkingDirectory=/var/lib/niac
ExecStart=/usr/bin/niac daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Network capabilities for packet capture and raw socket access
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/niac /var/log/niac /etc/niac
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateDevices=no
# Note: PrivateDevices=no required for network interface access

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

# Environment
Environment=HOME=/var/lib/niac
Environment=NIAC_CERT_DIR=/var/lib/niac/certs

[Install]
WantedBy=multi-user.target
