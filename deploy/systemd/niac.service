[Unit]
Description=NIAC Network Device Simulator
Documentation=https://github.com/krisarmstrong/niac
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=niac
Group=niac
ExecStart=/usr/bin/niac serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/niac /var/log/niac

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
