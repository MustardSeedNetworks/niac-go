{
  "name": "niac-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.2.1",
    "npm": ">=11.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "test:watch": "vitest --reporter=dot",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:e2e": "playwright test --reporter=list",
    "test:visual": "playwright test --project=visual --reporter=list",
    "test:visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.1",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.12.1",
    "@codemirror/state": "6.5.3",
    "@codemirror/view": "6.39.10",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-query": "5.90.16",
    "@xyflow/react": "12.10.0",
    "immer": "11.1.3",
    "lucide-react": "0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.12.0",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "zod": "3.24.2",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.57.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.0.8",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.0.17",
    "jsdom": "27.4.0",
    "playwright": "1.57.0",
    "postcss": "8.5.6",
    "rollup-plugin-visualizer": "5.14.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  }
}
