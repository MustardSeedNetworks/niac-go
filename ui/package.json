{
  "name": "niac-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.2.1",
    "npm": ">=11.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "test:watch": "vitest --reporter=dot",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:fullstack": "playwright test --config=playwright.fullstack.config.ts --reporter=list",
    "test:visual": "playwright test --project=visual --reporter=list",
    "test:visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.1",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/postcss": "4.2.4",
    "@tanstack/react-query": "5.100.9",
    "@xyflow/react": "12.10.2",
    "immer": "11.1.6",
    "lucide-react": "0.562.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.15.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "yaml": "2.9.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "27.4.0",
    "playwright": "1.59.1",
    "postcss": "8.5.14",
    "rollup-plugin-visualizer": "5.14.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "4.1.5",
    "zod": "4.4.3"
  }
}
