{
  "name": "niac-ui",
  "version": "0.95.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js",
    "build": "tsc --build && node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "build:analyze": "ANALYZE=true node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "typecheck": "tsc --build --noEmit",
    "preview": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --reporter=verbose",
    "test:watch": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs --reporter=dot",
    "test:coverage": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --coverage --reporter=verbose",
    "test:e2e": "NO_COLOR= node --disable-warning=DEP0205 ./node_modules/playwright/cli.js test --reporter=list",
    "test:e2e:auth": "NO_COLOR= node --disable-warning=DEP0205 ./node_modules/playwright/cli.js test --config=playwright.auth.config.ts",
    "test:e2e:fullstack": "NO_COLOR= node --disable-warning=DEP0205 ./node_modules/playwright/cli.js test --config=playwright.fullstack.config.ts --reporter=list",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "node scripts/check-i18n-extraction.ts",
    "i18n:lint": "biome check i18next.config.ts i18n-fixtures scripts/check-i18n-extraction.ts scripts/check-i18n-extraction.test.ts",
    "i18n:test": "node --test scripts/check-i18n-extraction.test.ts && i18next-cli --config i18n-fixtures/i18next.config.ts extract --ci",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook:run": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --config vitest.storybook.config.ts --project=storybook",
    "test:storybook": "npm run test:storybook:run",
    "test:storybook:contract": "../scripts/test-storybook-contract.sh"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/dagre": "0.7.54",
    "@xyflow/react": "12.11.5",
    "cmdk": "1.1.1",
    "dagre": "0.8.5",
    "html-to-image": "1.11.13",
    "i18next": "26.4.0",
    "i18next-browser-languagedetector": "8.2.1",
    "immer": "11.1.18",
    "lucide-react": "1.34.0",
    "nanoid": "6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-i18next": "17.0.12",
    "react-router": "8.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "valibot": "1.4.2",
    "yaml": "2.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@chromatic-com/storybook": "5.3.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "i18next-cli": "1.71.3",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.5.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@codemirror/state": "6.7.1",
    "nanoid": "6.0.1",
    "esbuild": "0.28.2"
  }
}
